# Copy to .env and fill in. NEVER commit .env.
# Do NOT prefix any of these with VITE_ — that would compile them into the public bundle.

DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB>?schema=public&sslmode=require&connection_limit=10"

# 32+ random bytes: openssl rand -base64 48
JWT_SECRET="<GENERATE_ME>"

PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# Public-facing admin WhatsApp number used by the contact-broker flow (E.164)
ADMIN_WHATSAPP="+6287894510004"
